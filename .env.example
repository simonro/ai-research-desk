# ai-research-desk settings. install.py copies this to ~/.hedge-desk/.env; edit it there.
# Nothing in this file is ever sent anywhere except to the service it belongs to.

# --- Which subscription answers the model calls (one per run) ------------------------------
# claude  : your Claude plan, through the Claude Code CLI (`claude`). Log in once with `claude`.
# chatgpt : your ChatGPT plan, through the Codex CLI (`codex`). Log the desk in once:
#           see "Using a ChatGPT plan" in the README.
DESK_PLAN=claude

# ChatGPT plan models: the strong role (managers, memos) and the fast role (analysts, checks).
# DESK_CHATGPT_STRONG=gpt-6-astra
# DESK_CHATGPT_FAST=gpt-6-luna

# --- Market data ----------------------------------------------------------------------------
# Optional. With Alpaca keys: the SIP feed, then IEX if your account has no SIP. Without keys:
# Yahoo prices and no news. Free Alpaca accounts work (paper trading keys are fine).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_DATA_FEED=auto

# Required by SEC EDGAR (free): a name and a contact email.
SEC_USER_AGENT=Your Name you@example.com

# --- Models on the Claude plan ---------------------------------------------------------------
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5
HEDGE_FUND_LLM_MODEL=claude-sonnet-5
HEDGE_FUND_MANAGER_MODEL=claude-opus-5-5
EDGE_DESK_MODEL=claude-sonnet-5

# --- Optional ---------------------------------------------------------------------------------
# FRED_API_KEY=                 free; TradingAgents' macro data
# DESK_MEMOS_DIR=               where memos and run folders go (default: memos/ in the repo)
# DESK_VAULT_DIR=               also write each memo as a note in this folder (e.g. Obsidian)
# EDGE_DESK_VAULT_DIR=          Edge Desk's notes, same idea
# DESK_LLM=api                  bill a metered ANTHROPIC_API_KEY instead of a plan
